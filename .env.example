# ---------- Aplicação ----------
APP_NAME=Runa AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ---------- Provedor de LLM ----------

LLM_PROVIDER=ollama

# ---------- Ollama / LLM ----------

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_API_KEY=sua_chave_aqui
VISION_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=5

# ---------- Groq (nuvem) ----------
GROQ_BASE_URL=https://api.groq.com/openai/v1

GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-120b

GROQ_VISION_MODEL=
GROQ_TIMEOUT_SECONDS=120

# ---------- Banco de dados ----------
DATABASE_URL=sqlite:///./runa.db

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5500","http://localhost:3000","https://runaia.netlify.app"]

# ---------- Limites de upload ----------
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_MESSAGE=20
MAX_ZIP_SIZE_MB=50
MAX_FILES_IN_ZIP=500
MAX_ZIP_UNCOMPRESSED_MB=300
MAX_ZIP_DEPTH=12
MAX_CONTEXT_CHARS=60000
STORAGE_DIR=./storage/uploads
