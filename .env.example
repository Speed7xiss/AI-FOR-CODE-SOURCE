# ---------- Aplicação ----------
APP_NAME=Runa AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ---------- Provedor de LLM ----------
# "ollama" (modelos locais) ou "groq" (nuvem, rapido, gratis dentro do limite)
LLM_PROVIDER=ollama

# ---------- Ollama / LLM ----------
# No Docker em Windows/macOS: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Para Ollama Cloud ou um endpoint protegido, informe a chave localmente (nunca aqui).
OLLAMA_API_KEY=6ae0a3c7c28140d1b471881fc6642390.viexD_f_kHRUY6RhAXWW9xRQ
# Modelo usado por padrão quando nenhum modelo é escolhido na interface.
OLLAMA_MODEL=qwen2.5-coder:7b
# Usado automaticamente para conversas com imagens. Deixe vazio para desabilitar.
VISION_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=5

# ---------- Groq (nuvem) ----------
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Uma ou mais chaves separadas por virgula (console.groq.com/keys).
# Se uma bater rate limit, a Runa tenta a proxima automaticamente.
GROQ_API_KEYS=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,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,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,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
GROQ_MODEL=openai/gpt-oss-120b
# Opcional: modelo Groq com suporte a imagem. Deixe vazio para desabilitar.
GROQ_VISION_MODEL=
GROQ_TIMEOUT_SECONDS=120

# ---------- Banco de dados ----------
DATABASE_URL=sqlite:///./runa.db

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5500","http://localhost:3000"]

# ---------- Limites de upload ----------
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_MESSAGE=20
MAX_ZIP_SIZE_MB=50
MAX_FILES_IN_ZIP=500
MAX_ZIP_UNCOMPRESSED_MB=300
MAX_ZIP_DEPTH=12
MAX_CONTEXT_CHARS=60000
STORAGE_DIR=./storage/uploads
